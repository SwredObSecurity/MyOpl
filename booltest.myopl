VAR a = TRUE
VAR b = FALSE
PRINT(a)
PRINT(b)
PRINT(Bool.and(a, b))
PRINT(Bool.or(a, b))
PRINT(Bool.not(b))
PRINT(Bool.xor(a, b))
PRINT(Bool.nand(a, a))
PRINT(Bool.implies(a, b))
PRINT(Bool.iff(a, a))
PRINT(Bool.toString(a))
PRINT(Bool.toYesNo(b))
PRINT(Bool.parse("true"))
PRINT(Bool.choose(TRUE, "picked-true", "picked-false"))
IF Bool.not(b) THEN PRINT("not false works")
IF TRUE THEN PRINT("TRUE in IF works")
PRINT(Bool.TRUE)
PRINT(Bool.FALSE)
