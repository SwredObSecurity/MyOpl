#*
   Bool — the companion class for the Bool type (truth values).

   MyOPL stores booleans as numbers: 0 is false, anything nonzero is true (the
   same values comparisons and IF/WHILE already use). The Bool TYPE is a built-in:
   declare with  Bool done = FALSE  (see Grammar.txt). Every function here
   normalises its inputs the same way, so passing 5 as "true" behaves like 1.

       Bool a = Bool.TRUE
       Bool b = Bool.FALSE
       PRINT(Bool.and(a, b))        # 0
       PRINT(Bool.or(a, b))         # 1
       PRINT(Bool.toString(a))      # "true"
       IF Bool.not(b) THEN PRINT("b was false")
*#
CLASS Bool BEGIN

   CONST TRUE  = 1          # represents truth
   CONST FALSE = 0          # represents falsehood

   # show prompt, read a yes/no answer ("true"/"yes"/"y"/"1" -> 1, else 0)
   FUN input(Str prompt) -> INPUT_BOOL(prompt)

   # --- normalisation ---

   # collapse any value to a strict 1 / 0  (nonzero -> 1)
   FUN of(Bool x) BEGIN
      IF x == 0 THEN
         RETURN 0
      ELSE
         RETURN 1
   END

   # --- core logic ---

   # flips truth into falsehood and back
   FUN not(Bool b) BEGIN
      IF b == 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   # true only if BOTH inputs are true
   FUN and(Bool a, Bool b) BEGIN
      IF a == 0 THEN
         RETURN 0
      IF b == 0 THEN
         RETURN 0
      RETURN 1
   END

   # true if EITHER input is true
   FUN or(Bool a, Bool b) BEGIN
      IF a == 0 THEN BEGIN
         IF b == 0 THEN
            RETURN 0
      END
      RETURN 1
   END

   # true if EXACTLY ONE input is true (not both)
   FUN xor(Bool a, Bool b) -> of(a) != of(b)

   # --- derived gates ---

   # opposite of and
   FUN nand(Bool a, Bool b) -> not(and(a, b))

   # opposite of or
   FUN nor(Bool a, Bool b) -> not(or(a, b))

   # false ONLY when a is true but b is false
   FUN implies(Bool a, Bool b) -> or(not(a), b)

   # true when both inputs match (both true or both false)
   FUN iff(Bool a, Bool b) -> not(xor(a, b))

   # --- conversions ---

   # number -> bool  (nonzero is true)
   FUN fromNum(Dec n) -> of(n)

   # bool -> "true" / "false"
   FUN toString(Bool b) BEGIN
      IF b == 0 THEN
         RETURN "false"
      ELSE
         RETURN "true"
   END

   # bool -> "yes" / "no"
   FUN toYesNo(Bool b) BEGIN
      IF b == 0 THEN
         RETURN "no"
      ELSE
         RETURN "yes"
   END

   # parse "true"/"yes"/"1" text into a bool; anything else -> 0
   FUN parse(Str s) BEGIN
      IF s == "true" THEN
         RETURN 1
      IF s == "yes" THEN
         RETURN 1
      IF s == "1" THEN
         RETURN 1
      RETURN 0
   END

   # pick one of two values by a condition  (a tiny ternary helper)
   FUN choose(Bool cond, Any ifTrue, Any ifFalse) BEGIN
      IF cond == 0 THEN
         RETURN ifFalse
      ELSE
         RETURN ifTrue
   END
END
