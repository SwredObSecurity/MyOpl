CLASS Math BEGIN
   # Constants — spec names are UPPERCASE; lowercase aliases kept for older scripts.
   CONST PI = 3.14159265358979
   CONST E = 2.71828182845904
   CONST TAU = 6.28318530717958
   CONST PHI = 1.61803398874989
   CONST SQRT2 = 1.41421356237309
   CONST LN2 = 0.69314718055994
   CONST LN10 = 2.30258509299404

   CONST pi = 3.14159265358979
   CONST e = 2.71828182845904
   CONST tau = 6.28318530717958
   CONST phi = 1.61803398874989
   CONST sqrt2 = 1.41421356237309
   CONST ln2 = 0.69314718055994
   CONST ln10 = 2.30258509299404

   FUN abs(Dec n) BEGIN
      IF n < 0 THEN
         RETURN 0 - n
      ELSE
         RETURN n
   END

   FUN sign(Dec n) BEGIN
      IF n == 0 THEN
         RETURN 0
      ELSE IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN -1
   END

   FUN min(Dec a, Dec b) BEGIN
      IF a < b THEN
         RETURN a
      ELSE
         RETURN b
   END

   FUN max(Dec a, Dec b) BEGIN
      IF a > b THEN
         RETURN a
      ELSE
         RETURN b
   END

   FUN clamp(Dec n, Dec lo, Dec hi) BEGIN
      IF n < lo THEN
         RETURN lo
      ELSE IF n > hi THEN
         RETURN hi
      ELSE
         RETURN n
   END

   FUN negate(Dec n) BEGIN
      RETURN 0 - n
   END

   FUN half(Dec n) BEGIN
      RETURN n / 2
   END

   FUN square(Dec n) BEGIN
      RETURN n * n
   END

   FUN cube(Dec n) BEGIN
      RETURN n * n * n
   END

   FUN average(Dec a, Dec b) BEGIN
      RETURN (a+b)/2
   END

   FUN isPos(Dec n) BEGIN
      IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN isNeg(Dec n) BEGIN
      IF n < 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN isZero(Dec n) BEGIN
      IF n == 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   # spec-named aliases for the three sign checks above
   FUN isPositive(Dec n) BEGIN
      IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN isNegative(Dec n) BEGIN
      IF n < 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   # 1 if a and b are within eps of each other, else 0
   FUN approxEqual(Dec a, Dec b, Dec eps) BEGIN
      IF abs(a - b) <= eps THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN lerp(Dec a, Dec b, Dec t) BEGIN
      RETURN (a + (b - a) * t)
   END

   FUN inverseLerp(Dec a, Dec b, Dec v) BEGIN
      RETURN ((v - a) / (b - a))
   END

   FUN remap(Dec v, Dec inLo, Dec inHi, Dec outLo, Dec outHi) BEGIN
      RETURN (outLo + (outHi - outLo) * ((v - inLo) / (inHi - inLo)))
   END

   # --- rounding (loop-based: meant for modest magnitudes) ---

   # largest whole number <= n  (works for negatives: floor(-2.5) = -3)
   FUN floor(Dec n) BEGIN
      VAR i = 0
      IF n >= 0 THEN BEGIN
         WHILE i + 1 <= n THEN BEGIN
            VAR i = i + 1
         END
      END ELSE BEGIN
         WHILE i > n THEN BEGIN
            VAR i = i - 1
         END
      END
      RETURN i
   END

   # smallest whole number >= n
   FUN ceil(Dec n) BEGIN
      RETURN -floor(-n)
   END

   # nearest whole number, halves round up:  round(2.5) = 3, round(-2.5) = -2
   FUN round(Dec n) BEGIN
      RETURN floor(n + 0.5)
   END

   # whole part toward zero:  trunc(2.9) = 2, trunc(-2.9) = -2
   FUN trunc(Dec n) BEGIN
      IF n >= 0 THEN
         RETURN floor(n)
      ELSE
         RETURN ceil(n)
   END

   # fractional part in [0, 1):  frac(2.25) = 0.25
   FUN frac(Dec n) BEGIN
      RETURN n - floor(n)
   END

   # a mod b  (floored modulo; result takes the sign of b)
   FUN mod(Dec a, Dec b) BEGIN
      RETURN a - floor(a / b) * b
   END

   # 1 if n is even, else 0  (n should be a whole number)
   FUN isEven(Int n) BEGIN
      IF mod(n, 2) == 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   # 1 if n is odd, else 0
   FUN isOdd(Int n) BEGIN
      IF mod(n, 2) == 0 THEN
         RETURN 0
      ELSE
         RETURN 1
   END

   # --- powers and roots ---

   # base raised to a WHOLE exponent (negative exponent allowed)
   FUN pow(Dec base, Int exp) BEGIN
      IF exp == 0 THEN
         RETURN 1
      IF exp < 0 THEN
         RETURN 1 / pow(base, -exp)
      VAR result = 1
      VAR i = 0
      WHILE i < exp THEN BEGIN
         VAR result = result * base
         VAR i = i + 1
      END
      RETURN result
   END

   # square root via Newton's method (returns 0 for n <= 0)
   FUN sqrt(Dec n) BEGIN
      IF n <= 0 THEN
         RETURN 0
      VAR guess = n
      VAR i = 0
      WHILE i < 30 THEN BEGIN
         VAR guess = (guess + n / guess) / 2
         VAR i = i + 1
      END
      RETURN guess
   END

   # length of the hypotenuse: sqrt(a*a + b*b)
   FUN hypot(Dec a, Dec b) BEGIN
      RETURN sqrt(a * a + b * b)
   END

   # straight-line distance between (x1,y1) and (x2,y2)
   FUN distance(Dec x1, Dec y1, Dec x2, Dec y2) BEGIN
      VAR dx = x2 - x1
      VAR dy = y2 - y1
      RETURN sqrt(dx * dx + dy * dy)
   END

   # --- number theory ---

   # n!  (factorial; factorial(0) = 1)
   FUN factorial(Int n) BEGIN
      VAR result = 1
      VAR i = 2
      WHILE i <= n THEN BEGIN
         VAR result = result * i
         VAR i = i + 1
      END
      RETURN result
   END

   # greatest common divisor (Euclid's algorithm)
   FUN gcd(Int a, Int b) BEGIN
      VAR x = abs(a)
      VAR y = abs(b)
      WHILE y > 0 THEN BEGIN
         VAR t = mod(x, y)
         VAR x = y
         VAR y = t
      END
      RETURN x
   END

   # least common multiple
   FUN lcm(Int a, Int b) BEGIN
      IF a == 0 THEN
         RETURN 0
      IF b == 0 THEN
         RETURN 0
      RETURN abs(a * b) / gcd(a, b)
   END

   # --- misc helpers ---

   # 1 / n
   FUN reciprocal(Dec n) BEGIN
      RETURN 1 / n
   END

   # clamp n into [0, 1]
   FUN clamp01(Dec n) BEGIN
      RETURN clamp(n, 0, 1)
   END

   # smallest / largest of three
   FUN min3(Dec a, Dec b, Dec c) -> min(a, min(b, c))
   FUN max3(Dec a, Dec b, Dec c) -> max(a, max(b, c))

   # degrees <-> radians
   FUN toRadians(Dec deg) BEGIN
      RETURN deg * pi / 180
   END

   FUN toDegrees(Dec rad) BEGIN
      RETURN rad * 180 / pi
   END
END
