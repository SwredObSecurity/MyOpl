#*
   Convert — real-world unit conversions.

       PRINT(Convert.celsiusToFahrenheit(100))   # 212.0
       PRINT(Convert.milesToKm(1))               # 1.609344
*#
CLASS Convert BEGIN

   # --- temperature ---
   FUN celsiusToFahrenheit(c) -> c * 9 / 5 + 32
   FUN fahrenheitToCelsius(f) -> (f - 32) * 5 / 9
   FUN celsiusToKelvin(c)     -> c + 273.15
   FUN kelvinToCelsius(k)     -> k - 273.15
   FUN fahrenheitToKelvin(f)  -> (f - 32) * 5 / 9 + 273.15
   FUN kelvinToFahrenheit(k)  -> (k - 273.15) * 9 / 5 + 32

   # --- length ---
   FUN milesToKm(m)     -> m * 1.609344
   FUN kmToMiles(k)     -> k / 1.609344
   FUN feetToMeters(ft) -> ft * 0.3048
   FUN metersToFeet(m)  -> m / 0.3048
   FUN inchesToCm(i)    -> i * 2.54
   FUN cmToInches(c)    -> c / 2.54
   FUN yardsToMeters(y) -> y * 0.9144
   FUN metersToYards(m) -> m / 0.9144

   # --- mass ---
   FUN kgToPounds(kg)   -> kg * 2.20462262185
   FUN poundsToKg(lb)   -> lb / 2.20462262185
   FUN gramsToOunces(g) -> g / 28.349523125
   FUN ouncesToGrams(oz) -> oz * 28.349523125

   # --- time ---
   FUN secondsToMinutes(s) -> s / 60
   FUN minutesToSeconds(m) -> m * 60
   FUN minutesToHours(m)   -> m / 60
   FUN hoursToMinutes(h)   -> h * 60
   FUN hoursToSeconds(h)   -> h * 3600
   FUN secondsToHours(s)   -> s / 3600
   FUN daysToHours(d)      -> d * 24
   FUN hoursToDays(h)      -> h / 24
   FUN daysToSeconds(d)    -> d * 86400

   # --- angle ---
   FUN degreesToRadians(d) -> d * 3.14159265358979 / 180
   FUN radiansToDegrees(r) -> r * 180 / 3.14159265358979

   # --- data size ---
   FUN bytesToKB(b) -> b / 1024
   FUN kbToMB(k)    -> k / 1024
   FUN mbToGB(m)    -> m / 1024
   FUN gbToTB(g)    -> g / 1024
   FUN bytesToMB(b) -> b / 1048576
   FUN bytesToGB(b) -> b / 1073741824
END
