#*
   Logging — friendlier-looking print statements.

       Logging.info("starting up")     # [INFO] starting up
       Logging.banner("Results")
*#
CLASS Logging BEGIN

   FUN info(Str msg)    -> PRINT("[INFO] " + msg)
   FUN warn(Str msg)    -> PRINT("[WARN] " + msg)
   FUN error(Str msg)   -> PRINT("[ERROR] " + msg)
   FUN debug(Str msg)   -> PRINT("[DEBUG] " + msg)
   FUN success(Str msg) -> PRINT("[OK] " + msg)

   # a row of dashes
   FUN divider() -> PRINT("------------------------------")

   # a divider, then the message, then another divider
   FUN banner(Str msg) BEGIN
      PRINT("------------------------------")
      PRINT(msg)
      PRINT("------------------------------")
   END

   # numbered progress:  [n] msg
   FUN step(Any n, Str msg) -> PRINT("[" + n + "] " + msg)

   # an empty line for spacing
   FUN blank() -> PRINT("")
END
