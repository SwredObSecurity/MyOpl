#*
   Constants — a grab-bag of common values everyone uses, in one place.

       PRINT(Constants.PI)
       PRINT(Constants.DAY_SECONDS)
*#
CLASS Constants BEGIN

   # --- math ---
   CONST PI  = 3.14159265358979
   CONST E   = 2.71828182845904
   CONST TAU = 6.28318530717958
   CONST PHI = 1.61803398874989

   # --- physics ---
   CONST GRAVITY_EARTH  = 9.81           # m/s^2
   CONST SPEED_OF_LIGHT = 299792458      # m/s

   # --- time ---
   CONST MINUTE_SECONDS = 60
   CONST HOUR_SECONDS   = 3600
   CONST DAY_SECONDS    = 86400
   CONST WEEK_DAYS      = 7
   CONST YEAR_DAYS      = 365

   # --- library info ---
   CONST VERSION = 1.0
END
