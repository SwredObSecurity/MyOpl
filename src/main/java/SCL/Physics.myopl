#*
   Physics — classroom physics formulas. Uses Math.sqrt where needed.

       PRINT(Physics.force(10, 2))          # 20.0
       PRINT(Physics.weight(5))             # 49.05
*#
CLASS Physics BEGIN

   CONST G_EARTH = 9.81               # m/s^2
   CONST G_MOON  = 1.62               # m/s^2
   CONST G_MARS  = 3.71               # m/s^2
   CONST SPEED_OF_LIGHT      = 299792458   # m/s
   CONST SPEED_OF_SOUND_AIR  = 343         # m/s (air at 20C)

   # F = mass x acceleration
   FUN force(m, a) -> m * a

   # energy of a moving object:  1/2 m v^2
   FUN kineticEnergy(m, v) -> 0.5 * m * v * v

   # energy of a raised object on Earth:  m g h
   FUN potentialEnergy(m, h) -> m * G_EARTH * h

   # mass x velocity
   FUN momentum(m, v) -> m * v

   # force applied across a distance
   FUN workDone(f, d) -> f * d

   # work done per unit time
   FUN mechanicalPower(w, t) -> w / t

   # force over an area
   FUN pressure(f, a) -> f / a

   # mass per volume
   FUN density(m, v) -> m / v

   # mass x Earth's gravity
   FUN weight(m) -> m * G_EARTH

   # distance covered per time
   FUN velocity(d, t) -> d / t

   # change in velocity over change in time
   FUN acceleration(dv, dt) -> dv / dt
END
