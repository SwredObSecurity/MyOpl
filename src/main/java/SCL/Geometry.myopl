#*
   Geometry — areas, perimeters, volumes and distances.
   Uses Math.sqrt, Math.PI and Math.SQRT2, so Math must be loaded first.

       PRINT(Geometry.circleArea(2))            # ~12.566
       PRINT(Geometry.distance2D(0, 0, 3, 4))   # 5.0
*#
CLASS Geometry BEGIN

   # --- circle ---
   FUN circleArea(Dec r)          -> Math.PI * r * r
   FUN circleCircumference(Dec r) -> 2 * Math.PI * r
   FUN circleDiameter(Dec r)      -> 2 * r

   # --- sphere ---
   FUN sphereVolume(Dec r)      -> 4 / 3 * Math.PI * r * r * r
   FUN sphereSurfaceArea(Dec r) -> 4 * Math.PI * r * r

   # --- rectangle ---
   FUN rectangleArea(Dec w, Dec h)      -> w * h
   FUN rectanglePerimeter(Dec w, Dec h) -> 2 * (w + h)
   FUN rectangleDiagonal(Dec w, Dec h)  -> Math.sqrt(w * w + h * h)

   # --- square ---
   FUN squareArea(Dec side)      -> side * side
   FUN squarePerimeter(Dec side) -> 4 * side
   FUN squareDiagonal(Dec side)  -> side * Math.SQRT2

   # --- triangle ---
   FUN triangleArea(Dec base, Dec height) -> base * height / 2
   FUN trianglePerimeter(Dec a, Dec b, Dec c) -> a + b + c

   # area from three side lengths (Heron's formula)
   FUN triangleAreaHeron(Dec a, Dec b, Dec c) BEGIN
      VAR s = (a + b + c) / 2
      RETURN Math.sqrt(s * (s - a) * (s - b) * (s - c))
   END

   # --- cube ---
   FUN cubeVolume(Dec s)      -> s * s * s
   FUN cubeSurfaceArea(Dec s) -> 6 * s * s

   # --- distance ---
   FUN distance2D(Dec x1, Dec y1, Dec x2, Dec y2)      -> Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1))
   FUN distanceSquared(Dec x1, Dec y1, Dec x2, Dec y2) -> (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)
   FUN pythagorean(Dec a, Dec b)               -> Math.sqrt(a * a + b * b)
END
