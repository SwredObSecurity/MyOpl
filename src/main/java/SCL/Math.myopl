CLASS Math BEGIN
   CONST pi = 3.14159265358979
   CONST e = 2.71828182845904
   CONST tau = 6.28318530717958
   CONST phi = 1.61803398874989
   CONST sqrt2 = 1.41421356237309
   CONST ln2 = 0.69314718055994
   CONST ln10 = 2.30258509299404

   FUN abs(n) BEGIN
      IF n < 0 THEN
         RETURN 0 - n
      ELSE
         RETURN n
   END

   FUN sign(n) BEGIN
      IF n == 0 THEN
         RETURN 0
      ELSE IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN -1
   END

   FUN min(a,b) BEGIN
      IF a < b THEN
         RETURN a
      ELSE
         RETURN b
   END

   FUN max(a,b) BEGIN
      IF a > b THEN
         RETURN a
      ELSE
         RETURN b
   END

   FUN clamp(n,lo,hi) BEGIN
      IF n < lo THEN
         RETURN lo
      ELSE IF n > hi THEN
         RETURN hi
      ELSE
         RETURN n
   END

   FUN negate(n) BEGIN
      RETURN 0 - n
   END

   FUN half(n) BEGIN
      RETURN n / 2
   END

   FUN square(n) BEGIN
      RETURN n * n
   END

   FUN cube(n) BEGIN
      RETURN n * n * n
   END

   FUN average(a,b) BEGIN
      RETURN (a+b)/2
   END

   FUN isPos(n) BEGIN
      IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN isNeg(n) BEGIN
      IF n < 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END

   FUN isZero(n) BEGIN
      IF n == 0 THEN
         RETURN 1
      ELSE
         RETURN 0
   END
END