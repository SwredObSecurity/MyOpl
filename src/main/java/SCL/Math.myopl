CLASS Math BEGIN
   CONST pi = 3.14159265358979
   CONST e = 2.71828182845904
   CONST tau = 6.28318530717958
   CONST phi = 1.61803398874989
   CONST sqrt2 = 1.41421356237309
   CONST ln2 = 0.69314718055994
   CONST ln10 = 2.30258509299404

   FUN abs(n) BEGIN
      IF n < 0 THEN
         RETURN 0 - n
      ELSE
         RETURN n
   END

   FUN sign(n) BEGIN
      IF n == 0 THEN
         RETURN 0
      ELSE IF n > 0 THEN
         RETURN 1
      ELSE
         RETURN -1
   END

   FUN min(a,b) BEGIN
      IF a < b THEN
         RETURN a
      ELSE
         RETURN b
   END


END